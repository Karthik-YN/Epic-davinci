{
  "name": "epic-davinci-tracker",
  "version": "1.0.0",
  "description": "21-Day Health & Lifestyle Challenge Tracker",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0 <22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "postinstall": "npm rebuild better-sqlite3 --build-from-source || true",
    "test": "node --experimental-vm-modules node_modules/.bin/jest tests/ --runInBand",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/unit/ --runInBand"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}
